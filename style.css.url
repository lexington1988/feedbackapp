:root{
  --bg:#0f0b16;
  --panel:#171026;
  --panel2:#1f1633;
  --text:#f2effa;
  --muted:#b8b2c9;
  --brand:#a855f7;
  --brand2:#7c3aed;
  --danger:#ef4444;
  --border:rgba(255,255,255,.08);
  --shadow: 0 12px 30px rgba(0,0,0,.35);
  --radius: 18px;
}

body{
  margin:0;
  font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial, "Apple Color Emoji","Segoe UI Emoji";
  background: radial-gradient(1200px 700px at 20% -10%, rgba(168,85,247,.25), transparent 60%),
              radial-gradient(900px 600px at 90% 0%, rgba(124,58,237,.18), transparent 55%),
              var(--bg);
  color:var(--text);
}

body.light{
  --bg:#f7f3ff;
  --panel:#ffffff;
  --panel2:#faf7ff;
  --text:#1b1028;
  --muted:#5c516c;
  --border:rgba(0,0,0,.08);
  --shadow: 0 10px 24px rgba(0,0,0,.12);
  background: radial-gradient(900px 500px at 20% -10%, rgba(168,85,247,.20), transparent 60%),
              radial-gradient(900px 600px at 90% 0%, rgba(124,58,237,.14), transparent 55%),
              var(--bg);
}

.app{
  max-width: 1180px;
  margin: 0 auto;
  padding: 22px 16px 40px;
}

.topbar{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:16px;
  margin-bottom: 16px;
}

h1{
  margin:0;
  font-size: 22px;
  letter-spacing:.2px;
}

.sub{
  margin:6px 0 0;
  color:var(--muted);
  font-size: 13px;
}

.top-actions{
  display:flex;
  gap:10px;
  align-items:center;
}

.grid{
  display:grid;
  grid-template-columns: 1.1fr .9fr;
  gap: 14px;
}

@media (max-width: 980px){
  .grid{ grid-template-columns: 1fr; }
}

.card{
  background: linear-gradient(180deg, var(--panel), var(--panel2));
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 16px;
}

h2{
  margin: 0 0 12px;
  font-size: 16px;
}

h3{
  margin: 0;
  font-size: 14px;
}

.form-grid{
  display:grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

@media (max-width: 560px){
  .form-grid{ grid-template-columns: 1fr; }
}

.field{
  display:flex;
  flex-direction:column;
  gap:6px;
}

.field span{
  font-size: 12px;
  color: var(--muted);
}

.field.inline{
  flex-direction:column;
  min-width: 140px;
}

input, select, textarea{
  padding: 10px 10px;
  border-radius: 12px;
  border: 1px solid var(--border);
  background: rgba(255,255,255,.04);
  color: var(--text);
  outline: none;
}

body.light input,
body.light select,
body.light textarea{
  background: rgba(0,0,0,.03);
}

textarea{ resize: vertical; }

.btn{
  border: 1px solid rgba(168,85,247,.55);
  background: linear-gradient(180deg, rgba(168,85,247,.95), rgba(124,58,237,.95));
  color: white;
  padding: 10px 12px;
  border-radius: 14px;
  cursor:pointer;
  font-weight: 650;
  letter-spacing:.2px;
}

.btn:hover{ filter: brightness(1.05); }

.btn.ghost{
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text);
}

.btn.small{
  padding: 7px 10px;
  border-radius: 12px;
  font-size: 13px;
}

.btn.danger{
  background: transparent;
  border: 1px solid rgba(239,68,68,.6);
  color: var(--text);
}

.icon-btn{
  border: 1px solid var(--border);
  background: transparent;
  color: var(--text);
  border-radius: 12px;
  padding: 8px 10px;
  cursor: pointer;
}

.split{
  margin-top: 14px;
  display:grid;
  grid-template-columns: 1fr;
  gap: 14px;
}

.section{
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 12px;
}

.section-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom: 10px;
}

.list{
  display:flex;
  flex-direction:column;
  gap: 8px;
}

.item{
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 10px;
  display:flex;
  gap: 10px;
  align-items:flex-start;
  justify-content:space-between;
}

.item .left{
  display:flex;
  flex-direction:column;
  gap:6px;
}

.item .title{
  font-weight: 700;
  font-size: 13.5px;
}

.item .meta{
  font-size: 12px;
  color: var(--muted);
}

.badges{
  display:flex;
  gap: 6px;
  flex-wrap: wrap;
}

.badge{
  font-size: 11px;
  padding: 4px 8px;
  border-radius: 999px;
  border: 1px solid var(--border);
  color: var(--text);
  background: rgba(255,255,255,.03);
}

.badge.sev-critical{ border-color: rgba(239,68,68,.7); }
.badge.sev-major{ border-color: rgba(251,146,60,.7); }
.badge.sev-minor{ border-color: rgba(59,130,246,.6); }
.badge.sev-advisory{ border-color: rgba(34,197,94,.55); }

.muted{
  color: var(--muted);
  font-size: 12px;
  margin: 8px 0 0;
}

.darkmode-box{
  margin-top: 14px;
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 12px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.toggle{
  display:flex;
  gap: 10px;
  align-items:center;
  color: var(--muted);
  font-size: 13px;
}

.tabs{
  display:flex;
  gap: 8px;
  margin-bottom: 12px;
}

.tab{
  flex:1;
  padding: 10px 10px;
  border-radius: 14px;
  border: 1px solid var(--border);
  background: transparent;
  color: var(--text);
  cursor:pointer;
  font-weight: 650;
}

.tab.active{
  border-color: rgba(168,85,247,.55);
  box-shadow: 0 0 0 3px rgba(168,85,247,.14) inset;
}

.tab-panel{ display:none; }
.tab-panel.active{ display:block; }

.row{
  display:flex;
  gap: 10px;
  flex-wrap: wrap;
  align-items: flex-end;
  margin-bottom: 10px;
}

.output{
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 12px;
  min-height: 260px;
  background: rgba(255,255,255,.02);
}

.pre{
  margin:0;
  white-space: pre-wrap;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  font-size: 12.5px;
  line-height: 1.45;
  color: var(--text);
}

.saved{
  display:flex;
  flex-direction:column;
  gap: 10px;
}

.saved-card{
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 12px;
  display:flex;
  justify-content:space-between;
  gap: 12px;
  align-items:flex-start;
}

.saved-card h4{
  margin:0;
  font-size: 13.5px;
}
.saved-card p{
  margin: 6px 0 0;
  color: var(--muted);
  font-size: 12px;
}

/* MODAL */
.backdrop{
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.55);
  backdrop-filter: blur(3px);
  z-index: 40;
}

.modal{
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%,-50%);
  width: min(720px, calc(100vw - 26px));
  background: linear-gradient(180deg, var(--panel), var(--panel2));
  border: 1px solid var(--border);
  border-radius: 18px;
  box-shadow: var(--shadow);
  z-index: 50;

  /* ✅ allow scrolling content on small screens */
  display: flex;
  flex-direction: column;
  max-height: calc(100vh - 26px);
}

/* Use dynamic viewport height on mobile when available (better with keyboard) */
@supports (height: 100dvh) {
  .modal { max-height: calc(100dvh - 26px); }
}

.modal-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding: 12px 12px 10px;
  border-bottom: 1px solid var(--border);

  /* ✅ keep header visible */
  flex: 0 0 auto;
}

.modal-body{
  padding: 12px;

  /* ✅ THIS is the key: body scrolls, not the whole page */
  overflow: auto;
  -webkit-overflow-scrolling: touch;
  flex: 1 1 auto;
}

.modal-foot{
  display:flex;
  gap: 10px;
  align-items:center;
  padding: 12px;
  border-top: 1px solid var(--border);

  /* ✅ keep footer visible */
  flex: 0 0 auto;
  background: linear-gradient(180deg, rgba(0,0,0,0), rgba(0,0,0,.06));
}


.spacer{ flex:1; }

.hidden{ display:none !important; }

.report-preview{
  background: rgba(255,255,255,.02);
}

.rp-title{
  margin: 0 0 6px;
  font-size: 16px;
}

.rp-meta{
  color: var(--muted);
  font-size: 12px;
  line-height: 1.35;
}

.rp-section-title{
  margin: 12px 0 6px;
  font-size: 13px;
  font-weight: 800;
}

.rp-list{
  margin: 0;
  padding-left: 18px;
  color: var(--text);
  font-size: 12.5px;
}

.rp-block{
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 10px;
  margin: 10px 0;
}

.rp-small{
  color: var(--muted);
  font-size: 12px;
}

/* PRINT */
@media print {
  /* Hide everything by default */
  body * {
    visibility: hidden !important;
  }

  /* Show ONLY printArea and its children */
  #printArea * {
    visibility: visible !important;
  }

  /* Put printArea at the top-left of the page */
  #printArea {
    position: absolute !important;
    left: 0 !important;
    top: 0 !important;
    width: 100% !important;
    height: auto !important;

    display: block !important;   /* important for CodePen */
    background: #fff !important;
    padding: 18px !important;
  }

    /* Base print typography */
  #printArea, #printArea * {
    color: #111 !important;
    background: transparent !important;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  #printArea h1 {
    margin: 0 0 10px;
    font-size: 22px;
    letter-spacing: .2px;
  }

  #printArea h3 {
    margin: 0 0 8px;
    font-size: 13.5px;
  }

  /* “Meta” lines under the title */
  #printArea .muted {
    color: #444 !important;
    font-size: 12px;
    line-height: 1.35;
    margin: 0 0 10px;
  }

  /* ✅ Polished card sections (this brings back your “original” look) */
  #printArea .box {
    border: 1px solid #d7d7d7 !important;
    border-radius: 12px !important;
    padding: 12px 14px !important;
    margin: 12px 0 !important;
    background: #fff !important;
  }

  /* Lists */
  #printArea ul {
    margin: 6px 0 0;
    padding-left: 18px;
  }
  #printArea li {
    margin: 4px 0;
  }

  /* Finding blocks */
  #printArea .rp-block {
    border: 1px solid #e2e2e2 !important;
    border-radius: 10px !important;
    padding: 10px 12px !important;
    margin: 10px 0 !important;
  }

  #printArea .rp-small,
  #printArea .rp-meta {
    color: #555 !important;
    font-size: 12px;
    line-height: 1.35;
  }


  /* Remove any app layout spacing affecting print */
  html, body {
    margin: 0 !important;
    padding: 0 !important;
  }
}

/* Engineers tab helpers */
#tabEngineers .output { min-height: 320px; }

